{
  "name": "animevision-desktop",
  "productName": "AnimeVision",
  "version": "1.0.4",
  "description": "AnimeVision pour Windows",
  "author": "tidic84",
  "license": "MIT",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "com.tidic84.animevision",
    "productName": "AnimeVision",
    "files": [
      "main.cjs",
      "icon.png",
      "package.json",
      "electron-source.cjs",
      "catalog-service.cjs"
    ],
    "extraResources": [
      {
        "from": "../dist-web",
        "to": "web"
      },
      {
        "from": "../catalog-server/src",
        "to": "catalog-server/src"
      },
      {
        "from": "../catalog-server/node_modules",
        "to": "catalog-server/node_modules",
        "filter": [
          "**/*",
          "!playwright{,/**}",
          "!playwright-core{,/**}",
          "!.bin{,/**}"
        ]
      }
    ],
    "directories": {
      "output": "../dist-desktop"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AnimeVision",
      "artifactName": "AnimeVision-Setup-${version}.exe"
    }
  }
}
