{
  "name": "animevisionapp",
  "version": "1.0.3",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web --output-dir dist-web",
    "export:android": "expo export --platform android --output-dir dist-android",
    "release": "node scripts/release.cjs",
    "test": "node tests/test-download-management.cjs && node tests/test-load-scheduler.cjs && node tests/test-logger.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
